{
  "name": "the-11-11",
  "version": "1.8.0",
  "private": true,
  "description": "THE 11:11 mystery game",
  "scripts": {
    "build:android": "cap sync android",
    "build:windows": "electron-builder --win nsis"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "main": "electron-main.cjs",
  "build": {
    "appId": "com.nightfallstudios.the1111",
    "productName": "THE 11:11",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "style.css",
      "game.js",
      "assets/**/*",
      "electron-main.cjs"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
